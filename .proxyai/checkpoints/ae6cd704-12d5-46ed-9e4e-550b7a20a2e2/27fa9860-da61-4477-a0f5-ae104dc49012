                    "text": "1\timport java.awt.Color;\n2\timport java.io.File;\n3\timport java.io.FileInputStream;\n4\timport java.util.*;\n5\timport java.util.stream.Collectors;\n6\t\n7\timport org.openstreetmap.osmosis.core.container.v0_6.EntityContainer;\n8\timport org.openstreetmap.osmosis.core.domain.v0_6.Entity;\n9\timport org.openstreetmap.osmosis.core.domain.v0_6.Node;\n10\timport org.openstreetmap.osmosis.core.domain.v0_6.Relation;\n11\timport org.openstreetmap.osmosis.core.domain.v0_6.RelationMember;\n12\timport org.openstreetmap.osmosis.core.domain.v0_6.Tag;\n13\timport org.openstreetmap.osmosis.core.domain.v0_6.Way;\n14\timport org.openstreetmap.osmosis.core.domain.v0_6.WayNode;\n15\timport org.openstreetmap.osmosis.core.task.v0_6.Sink;\n16\t\n17\timport crosby.binary.osmosis.OsmosisReader;\n18\t\n19\timport nl.tudelft.simulation.dsol.animation.gis.FeatureInterface;\n20\timport nl.tudelft.simulation.dsol.animation.gis.GisObject;\n21\timport nl.tudelft.simulation.dsol.animation.gis.SerializablePath;\n22\timport nl.tudelft.simulation.dsol.animation.gis.map.Feature;\n23\timport nl.tudelft.simulation.dsol.animation.gis.map.GisMap;\n24\timport nl.tudelft.simulation.dsol.animation.gis.map.Layer;\n25\timport nl.tudelft.simulation.dsol.animation.gis.transform.CoordinateTransform;\n26\t\n27\t/**\n28\t * 使用 nl.tudelft.simulation.dsol.animation.gis.osm 库解析 OSM PBF 文件，\n29\t * 将地图要素按图层分类：点要素图层（Nodes）、线要素图层（非闭合Ways）、面要素图层（闭合Ways + 多边形Relations）。\n30\t * <p>\n31\t * 核心模型：\n32\t * - {@link GisMap}   — 地图容器，包含多个图层\n33\t * - {@link Layer}    — 图层（点图层/线图层/面图层），包含多个要素\n34\t * - {@link Feature}  — 要素分类（如 highway、building、amenity），包含多个几何对象\n35\t * - {@link GisObject} — 几何对象（封装 {@link SerializablePath} 形状 + 属性数组）\n36\t */\n37\tpublic class Main {\n38\t\n39\t    // ==================== 图层名称常量 ====================\n40\t    private static final String POINT_LAYER_NAME   = \"点要素图层 (Points)\";\n41\t    private static final String LINE_LAYER_NAME    = \"线要素图层 (Lines)\";\n42\t    private static final String POLYGON_LAYER_NAME = \"面要素图层 (Polygons)\";\n43\t\n44\t    // ==================== 数据模型 ====================\n45\t\n46\t    /**\n47\t     * 解析结果：包含 GisMap（含三层图层）和统计摘要。\n48\t     */\n49\t    public static class OsmParseResult {\n50\t        public final GisMap gisMap;\n51\t        public final Layer pointLayer;\n52\t        public final Layer lineLayer;\n53\t        public final Layer polygonLayer;\n54\t        public final int totalNodeCount;\n55\t        public final int totalWayCount;\n56\t        public final int totalRelationCount;\n57\t        public final int pointFeatureCount;\n58\t        public final int lineFeatureCount;\n59\t        public final int polygonFeatureCount;\n60\t\n61\t        public OsmParseResult(GisMap gisMap, Layer pointLayer, Layer lineLayer, Layer polygonLayer,\n62\t                              int totalNodeCount, int totalWayCount, int totalRelationCount,\n63\t                              int pointFeatureCount, int lineFeatureCount, int polygonFeatureCount) {\n64\t            this.gisMap = gisMap;\n65\t            this.pointLayer = pointLayer;\n66\t            this.lineLayer = lineLayer;\n67\t            this.polygonLayer = polygonLayer;\n68\t            this.totalNodeCount = totalNodeCount;\n69\t            this.totalWayCount = totalWayCount;\n70\t            this.totalRelationCount = totalRelationCount;\n71\t            this.pointFeatureCount = pointFeatureCount;\n72\t            this.lineFeatureCount = lineFeatureCount;\n73\t            this.polygonFeatureCount = polygonFeatureCount;\n74\t        }\n75\t\n76\t        /** 返回所有图层的列表（便于迭代） */\n77\t        public List<Layer> getLayers() {\n78\t            return List.of(pointLayer, lineLayer, polygonLayer);\n79\t        }\n80\t    }\n81\t\n82\t    // ==================== 核心解析逻辑 ====================\n83\t\n84\t    /**\n85\t     * 解析 OSM PBF 文件，将要素按几何类型分到点/线/面三个图层。\n86\t     *\n87\t     * @param pbfFile PBF 文件路径\n88\t     * @return OsmParseResult 包含 GisMap 和统计信息\n89\t     */\n90\t    public static OsmParseResult parseOsmFile(String pbfFile) throws Exception {\n91\t        File file = new File(pbfFile);\n92\t        if (!file.exists()) {\n93\t            throw new RuntimeException(\"文件不存在: \" + pbfFile);\n94\t        }\n95\t\n96\t        // ── 创建三个图层 ──\n97\t        Layer pointLayer   = createLayer(POINT_LAYER_NAME);\n98\t        Layer lineLayer    = createLayer(LINE_LAYER_NAME);\n99\t        Layer polygonLayer = createLayer(POLYGON_LAYER_NAME);\n100\t\n101\t        // ── 临时存储 ──\n102\t        Map<Long, MiniNode> nodeMap = new HashMap<>();          // 所有节点（坐标）\n103\t        List<Way> allWays = new ArrayList<>();                    // 暂存所有Way（等relation解析后再分类）\n104\t        Map<Long, List<MiniMember>> relationWays = new HashMap<>(); // relation → 成员way列表\n105\t\n106\t        int[] counters = new int[3]; // [nodeCount, wayCount, relationCount]\n107\t\n108\t        // ── 使用 OsmosisBinaryParser 解析 PBF ──\n109\t        OsmosisBinaryParser parser = new OsmosisBinaryParser();\n110\t        parser.setSink(new Sink() {\n111\t            @Override\n112\t            public void process(EntityContainer container) {\n113\t                Entity entity = container.getEntity();\n114\t\n115\t                if (entity instanceof Node node) {\n116\t                    counters[0]++;\n117\t                    nodeMap.put(node.getId(), new MiniNode(node.getLatitude(), node.getLongitude(),\n118\t                            tagsToMap(node.getTags())));\n119\t                } else if (entity instanceof Way way) {\n120\t                    counters[1]++;\n121\t                    allWays.add(way);\n122\t                } else if (entity instanceof Relation relation) {\n123\t                    counters[2]++;\n124\t                    // 收集 multipolygon / boundary 等面状关系\n125\t                    String type = getTagValue(relation, \"type\");\n126\t                    if (\"multipolygon\".equals(type) || \"boundary\".equals(type)) {\n127\t                        for (RelationMember member : relation.getMembers()) {\n128\t                            if (\"way\".equals(member.getMemberType().name().toLowerCase())\n129\t                                    || \"way\".equals(member.getMemberType().toString().toLowerCase())) {\n130\t                                relationWays.computeIfAbsent(relation.getId(), k -> new ArrayList<>())\n131\t                                        .add(new MiniMember(member.getMemberId(), member.getMemberRole()));\n132\t                            }\n133\t                        }\n134\t                    }\n135\t                }\n136\t            }\n137\t\n138\t            @Override public void initialize(Map<String, Object> metaData) {}\n139\t            @Override public void complete() {}\n140\t            @Override public void close() {}\n141\t        });\n142\t\n143\t        try (FileInputStream fis = new FileInputStream(file);\n144\t             BlockInputStream bis = new BlockInputStream(fis, parser)) {\n145\t            bis.process();\n146\t        }\n147\t\n148\t        int totalNodeCount = counters[0];\n149\t        int totalWayCount  = counters[1];\n150\t        int totalRelationCount = counters[2];\n151\t\n152\t        System.out.println(\"[解析] 原始数据: Node=\" + totalNodeCount\n153\t                + \", Way=\" + totalWayCount + \", Relation=\" + totalRelationCount);\n154\t\n155\t        // ── 收集 relation 引用的 wayId（这些way属于面图层的一部分） ──\n156\t        Set<Long> relationWayIdSet = relationWays.values().stream()\n157\t                .flatMap(List::stream)\n158\t                .map(m -> m.wayId)\n159\t                .collect(Collectors.toSet());\n160\t\n161\t        // ── 将 Ways 分类到线/面图层 ──\n162\t        int[] layerCounts = new int[3]; // [point, line, polygon]\n163\t\n164\t        for (Way way : allWays) {\n165\t            List<WayNode> wayNodes = way.getWayNodes();\n166\t            if (wayNodes.isEmpty()) continue;\n167\t\n168\t            boolean isClosed = wayNodes.get(0).getNodeId() == wayNodes.get(wayNodes.size() - 1).getNodeId();\n169\t            boolean inRelation = relationWayIdSet.contains(way.getId());\n170\t            Map<String, String> tags = tagsToMap(way.getTags());\n171\t\n172\t            SerializablePath path = buildPath(wayNodes, nodeMap);\n173\t            if (path == null) continue;\n174\t\n175\t            if (isClosed || inRelation) {\n176\t                // 面要素（闭合Way 或 属于multipolygon relation）\n177\t                addGisObjectToLayer(polygonLayer, way.getId(), tags, path, wayNodes.size());\n178\t                layerCounts[2]++;\n179\t            } else {\n180\t                // 线要素（非闭合Way）\n181\t                addGisObjectToLayer(lineLayer, way.getId(), tags, path, wayNodes.size());\n182\t                layerCounts[1]++;\n183\t            }\n184\t        }\n185\t\n186\t        // ── 处理被 Way 引用过的节点 → 从点图层候选集合中移除 ──\n187\t        Set<Long> referencedNodeIds = new HashSet<>();\n188\t        for (Way way : allWays) {\n189\t            for (WayNode wn : way.getWayNodes()) {\n190\t                referencedNodeIds.add(wn.getNodeId());\n191\t            }\n192\t        }\n193\t\n194\t        // ── 点要素：有标签且未被Way引用的独立节点 ──\n195\t        for (Map.Entry<Long, MiniNode> entry : nodeMap.entrySet()) {\n196\t            long nodeId = entry.getKey();\n197\t            MiniNode miniNode = entry.getValue();\n198\t            if (!referencedNodeIds.contains(nodeId) && !miniNode.tags.isEmpty()) {\n199\t                // 创建一个仅有一个点的路径\n200\t                SerializablePath pointPath = new SerializablePath(1);\n201\t                pointPath.moveTo((float) miniNode.lon, (float) miniNode.lat);\n202\t                pointPath.lineTo((float) miniNode.lon, (float) miniNode.lat);\n203\t                addGisObjectToLayer(pointLayer, nodeId, miniNode.tags, pointPath, 1);\n204\t                layerCounts[0]++;\n205\t            }\n206\t        }\n207\t\n208\t        System.out.println(\"[分类] 点要素: \" + layerCounts[0]\n209\t                + \", 线要素: \" + layerCounts[1] + \", 面要素: \" + layerCounts[2]);\n210\t\n211\t        // ── 构建 GisMap ──\n212\t        GisMap gisMap = new GisMap();\n213\t        gisMap.setName(\"OSM 地图 — 江西省\");\n214\t        gisMap.addLayer(pointLayer);\n215\t        gisMap.addLayer(lineLayer);\n216\t        gisMap.addLayer(polygonLayer);\n217\t\n218\t        return new OsmParseResult(gisMap, pointLayer, lineLayer, polygonLayer,\n219\t                totalNodeCount, totalWayCount, totalRelationCount,\n220\t                layerCounts[0], layerCounts[1], layerCounts[2]);\n221\t    }\n222\t\n223\t    // ==================== 辅助方法 ====================\n224\t\n225\t    /**\n226\t     * 将 Osmosis Tag 集合转为不可变 Map。\n227\t     */\n228\t    private static Map<String, String> tagsToMap(Collection<Tag> tags) {\n229\t        Map<String, String> map = new LinkedHashMap<>();\n230\t        for (Tag tag : tags) {\n231\t            map.put(tag.getKey(), tag.getValue());\n232\t        }\n233\t        return Collections.unmodifiableMap(map);\n234\t    }\n235\t\n236\t    /**\n237\t     * 从 Entity 中获取指定 key 的 tag value。\n238\t     */\n239\t    private static String getTagValue(Entity entity, String key) {\n240\t        for (Tag tag : entity.getTags()) {\n241\t            if (key.equals(tag.getKey())) return tag.getValue();\n242\t        }\n243\t        return null;\n244\t    }\n245\t\n246\t    /**\n247\t     * 根据 WayNodes 构建 SerializablePath。\n248\t     */\n249\t    private static SerializablePath buildPath(List<WayNode> wayNodes, Map<Long, MiniNode> nodeMap) {\n250\t        SerializablePath path = new SerializablePath(1, wayNodes.size());\n251\t        boolean first = true;\n252\t        for (WayNode wn : wayNodes) {\n253\t            MiniNode mn = nodeMap.get(wn.getNodeId());\n254\t            if (mn == null) continue;\n255\t            float x = (float) mn.lon;\n256\t            float y = (float) mn.lat;\n257\t            if (first) {\n258\t                path.moveTo(x, y);\n259\t                first = false;\n260\t            } else {\n261\t                path.lineTo(x, y);\n262\t            }\n263\t        }\n264\t        return first ? null : path; // 如果没有任何有效节点，返回 null\n265\t    }\n266\t\n267\t    /**\n268\t     * 创建一个 GisObject 并添加到对应 Layer 的 Feature 中。\n269\t     * 按 tag 的 main key（如 highway / building / amenity）归类到不同的 Feature。\n270\t     */\n271\t    private static void addGisObjectToLayer(Layer layer, long osmId, Map<String, String> tags,\n272\t                                            SerializablePath path, int nodeCount) {\n273\t        // 确定要素的主分类 key\n274\t        String mainKey = extractMainCategory(tags);\n275\t\n276\t        // 在图层中查找或创建对应 Feature\n277\t        Feature feature = findOrCreateFeature(layer, mainKey, tags);\n278\t\n279\t        // 构建属性数组 [osmId, mainKey, tagSummary, nodeCount]\n280\t        String[] attrs = new String[] {\n281\t                String.valueOf(osmId),\n282\t                mainKey,\n283\t                summarizeTags(tags),\n284\t                String.valueOf(nodeCount)\n285\t        };\n286\t\n287\t        feature.getShapes().add(new GisObject(path, attrs));\n288\t    }\n289\t\n290\t    /**\n291\t     * 提取 OSM 要素的主要分类 key。\n292\t     * 优先级: highway > building > waterway > landuse > natural > railway >\n293\t     *          amenity > leisure > boundary > power > 其他第一个 tag key\n294\t     */\n295\t    private static String extractMainCategory(Map<String, String> tags) {\n296\t        String[] priorityKeys = {\n297\t                \"highway\", \"building\", \"waterway\", \"landuse\", \"natural\", \"railway\",\n298\t                \"amenity\", \"leisure\", \"boundary\", \"power\", \"barrier\", \"place\"\n299\t        };\n300\t        for (String key : priorityKeys) {\n301\t            if (tags.containsKey(key)) return key;\n302\t        }\n303\t        // fallback: 返回第一个 tag 的 key\n304\t        return tags.isEmpty() ? \"unknown\" : tags.keySet().iterator().next();\n305\t    }\n306\t\n307\t    /**\n308\t     * 在图层中查找匹配的 Feature，没有则创建新的。\n309\t     */\n310\t    private static Feature findOrCreateFeature(Layer layer, String mainKey, Map<String, String> tags) {\n311\t        String value = tags.getOrDefault(mainKey, \"*\");\n312\t\n313\t        // 先在已有 Feature 中查找\n314\t        for (FeatureInterface fi : layer.getFeatures()) {\n315\t            Feature f = (Feature) fi;\n316\t            if (mainKey.equals(f.getKey()) && (\"*\".equals(f.getValue()) || value.equals(f.getValue()))) {\n317\t                return f;\n318\t            }\n319\t        }\n320\t\n321\t        // 未找到则创建新 Feature\n322\t        Feature feature = new Feature();\n323\t        feature.setKey(mainKey);\n324\t        feature.setValue(value);\n325\t        feature.setFillColor(pickColor(mainKey));\n326\t        feature.setOutlineColor(Color.DARK_GRAY);\n327\t        layer.addFeature(feature);\n328\t        return feature;\n329\t    }\n330\t\n331\t    /**\n332\t     * 根据要素类型分配颜色。\n333\t     */\n334\t    private static Color pickColor(String mainKey) {\n335\t        return switch (mainKey) {\n336\t            case \"highway\"   -> new Color(255, 200, 120);\n337\t            case \"building\"  -> new Color(210, 180, 140);\n338\t            case \"waterway\"  -> new Color(100, 150, 255);\n339\t            case \"landuse\"   -> new Color(180, 220, 150);\n340\t            case \"natural\"   -> new Color(140, 200, 120);\n341\t            case \"railway\"   -> new Color(180, 180, 180);\n342\t            case \"amenity\"   -> new Color(255, 160, 160);\n343\t            case \"leisure\"   -> new Color(170, 230, 170);\n344\t            case \"boundary\"  -> new Color(200, 160, 200);\n345\t            case \"power\"     -> new Color(255, 255, 150);\n346\t            case \"barrier\"   -> new Color(160, 160, 160);\n347\t            case \"place\"     -> new Color(255, 220, 180);\n348\t            default          -> new Color(200, 200, 200);\n349\t        };\n350\t    }\n351\t\n352\t    /**\n353\t     * 将 tags 压缩为简短的可读字符串。\n354\t     */\n355\t    private static String summarizeTags(Map<String, String> tags) {\n356\t        if (tags.isEmpty()) return \"-\";\n357\t        StringBuilder sb = new StringBuilder();\n358\t        String[] priorityKeys = {\"highway\", \"name\", \"building\", \"waterway\", \"landuse\",\n359\t                \"natural\", \"amenity\", \"leisure\", \"railway\", \"place\"};\n360\t        for (String key : priorityKeys) {\n361\t            String val = tags.get(key);\n362\t            if (val != null) {\n363\t                if (!sb.isEmpty()) sb.append(\"; \");\n364\t                sb.append(key).append(\"=\").append(val);\n365\t            }\n366\t        }\n367\t        return sb.isEmpty() ? tags.toString() : sb.toString();\n368\t    }\n369\t\n370\t    /**\n371\t     * 创建并初始化一个 Layer。\n372\t     */\n373\t    private static Layer createLayer(String name) {\n374\t        Layer layer = new Layer();\n375\t        layer.setName(name);\n376\t        layer.setDisplay(true);\n377\t        layer.setTransform(false);\n378\t        return layer;\n379\t    }\n380\t\n381\t    // ==================== 内部数据类 ====================\n382\t\n383\t    /** 精简节点（仅坐标 + 标签） */\n384\t    private static class MiniNode {\n385\t        final double lat, lon;\n386\t        final Map<String, String> tags;\n387\t        MiniNode(double lat, double lon, Map<String, String> tags) {\n388\t            this.lat = lat; this.lon = lon; this.tags = tags;\n389\t        }\n390\t    }\n391\t\n392\t    /** Relation 成员引用 */\n393\t    private static class MiniMember {\n394\t        final long wayId;\n395\t        final String role;\n396\t        MiniMember(long wayId, String role) { this.wayId = wayId; this.role = role; }\n397\t    }\n398\t\n399\t    // ==================== 打印与诊断 ====================\n400\t\n401\t    /**\n402\t     * 打印 GisMap 各图层的详细统计信息。\n403\t     */\n404\t    private static void printLayerDetails(OsmParseResult result) {\n405\t        for (Layer layer : result.getLayers()) {\n406\t            System.out.println(\"\\n━━━ \" + layer.getName() + \" ━━━\");\n407\t            List<FeatureInterface> features = layer.getFeatures();\n408\t            int totalShapes = 0;\n409\t\n410\t            // 按 shape 数量降序排列\n411\t            List<FeatureInterface> sorted = new ArrayList<>(features);\n412\t            sorted.sort((a, b) -> Integer.compare(b.getNumShapes(), a.getNumShapes()));\n413\t\n414\t            for (FeatureInterface fi : sorted) {\n415\t                Feature f = (Feature) fi;\n416\t                int n = f.getNumShapes();\n417\t                totalShapes += n;\n418\t                String desc = String.format(\"  %-15s = %-25s  → %,6d 个几何对象\",\n419\t                        f.getKey(), f.getValue(), n);\n420\t                System.out.println(desc);\n421\t            }\n422\t            System.out.println(String.format(\"  【合计: %d 种要素分类, %,d 个几何对象】\",\n423\t                    features.size(), totalShapes));\n424\t        }\n425\t    }\n426\t\n427\t    /**\n428\t     * 打印部分几何对象样例。\n429\t     */\n430\t    private static void printSampleShapes(OsmParseResult result, int samplesPerLayer) {\n431\t        for (Layer layer : result.getLayers()) {\n432\t            System.out.println(\"\\n--- \" + layer.getName() + \" 样例 (前\" + samplesPerLayer + \"个) ---\");\n433\t            int count = 0;\n434\t            for (FeatureInterface fi : layer.getFeatures()) {\n435\t                if (count >= samplesPerLayer) break;\n436\t                Feature f = (Feature) fi;\n437\t                for (GisObject obj : f.getShapes()) {\n438\t                    if (count >= samplesPerLayer) break;\n439\t                    String[] attrs = obj.getAttributeValues();\n440\t                    System.out.printf(\"  [%s] osmId=%s, 标签={%s}, 节点数=%s%n\",\n441\t                            f.getKey(), attrs[0], attrs[2], attrs[3]);\n442\t                    count++;\n443\t                }\n444\t            }\n445\t        }\n446\t    }\n447\t\n448\t    // ==================== 主入口 ====================\n449\t\n450\t    public static void main(String[] args) throws Exception {\n451\t        String pbfPath = \"src/main/resources/jiangxi-260526.osm.pbf\";\n452\t\n453\t        System.out.println(\"╔══════════════════════════════════════════════╗\");\n454\t        System.out.println(\"║   OSM PBF 地图解析 — dsol GIS 三层模型       ║\");\n455\t        System.out.println(\"║   点要素 / 线要素 / 面要素                    ║\");\n456\t        System.out.println(\"╚══════════════════════════════════════════════╝\");\n457\t        System.out.println(\"\\n文件: \" + pbfPath);\n458\t\n459\t        long startTime = System.currentTimeMillis();\n460\t        OsmParseResult result = parseOsmFile(pbfPath);\n461\t        long elapsed = System.currentTimeMillis() - startTime;\n462\t\n463\t        System.out.println(\"\\n========================================\");\n464\t        System.out.println(\"解析完成，耗时: \" + elapsed + \" ms\");\n465\t        System.out.println(\"========================================\");\n466\t        System.out.println(\"原始Node总数:     \" + String.format(\"%,d\", result.totalNodeCount));\n467\t        System.out.println(\"原始Way总数:      \" + String.format(\"%,d\", result.totalWayCount));\n468\t        System.out.println(\"原始Relation总数: \" + String.format(\"%,d\", result.totalRelationCount));\n469\t        System.out.println(\"----------------------------------------\");\n470\t        System.out.println(\"点要素数量:       \" + String.format(\"%,d\", result.pointFeatureCount));\n471\t        System.out.println(\"线要素数量:       \" + String.format(\"%,d\", result.lineFeatureCount));\n472\t        System.out.println(\"面要素数量:       \" + String.format(\"%,d\", result.polygonFeatureCount));\n473\t        System.out.println(\"========================================\");\n474\t\n475\t        // 打印各图层详细统计\n476\t        printLayerDetails(result);\n477\t\n478\t        // 打印样例几何对象\n479\t        printSampleShapes(result, 8);\n480\t    }\n481\t}\n482"
                }
