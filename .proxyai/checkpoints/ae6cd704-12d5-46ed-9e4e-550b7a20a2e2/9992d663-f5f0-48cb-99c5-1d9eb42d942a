"线要素图层 (Lines)\\\";\\n    private static final String POLYGON_LAYER_NAME = \\\"面要素图层 (Polygons)\\\";\\n\\n    // ==================== 解析结果类型 ====================\\n\\n    /** 解析结果：包含 GisMap（含三层图层）和统计摘要。 */\\n    public static class OsmParseResult {\\n        public final GisMap gisMap;\\n        public final Layer pointLayer;\\n        public final Layer lineLayer;\\n        public final Layer polygonLayer;\\n        public final int totalNodeCount;\\n        public final int totalWayCount;\\n        public final int totalRelationCount;\\n        public final int pointFeatureCount;\\n        public final int lineFeatureCount;\\n        public final int polygonFeatureCount;\\n\\n        public OsmParseResult(GisMap gisMap, Layer pointLayer, Layer lineLayer, Layer polygonLayer,\\n                              int totalNodeCount, int totalWayCount, int totalRelationCount,\\n                              int pointFeatureCount, int lineFeatureCount, int polygonFeatureCount) {\\n            this.gisMap = gisMap;\\n            this.pointLayer = pointLayer;\\n            this.lineLayer = lineLayer;\\n            this.polygonLayer = polygonLayer;\\n            this.totalNodeCount = totalNodeCount;\\n            this.totalWayCount = totalWayCount;\\n            this.totalRelationCount = totalRelationCount;\\n            this.pointFeatureCount = pointFeatureCount;\\n            this.lineFeatureCount = lineFeatureCount;\\n            this.polygonFeatureCount = polygonFeatureCount;\\n        }\\n\\n        /** 返回所有图层的列表（便于迭代）。 */\\n        public List<Layer> getLayers() {\\n            return List.of(pointLayer, lineLayer, polygonLayer);\\n        }\\n    }\\n\\n    // ==================== 核心解析方法 ====================\\n\\n    /**\\n     * 解析 OSM PBF 文件，将要素按几何类型分到点/线/面三个图层。\\n     * <p>\\n     * 使用与 {@code OsmFileReader} 相同的 {@link OsmosisReader} 进行 PBF 解析，\\n     * 但通过自定义的 {@link LayeredOsmSink} 直接构建三层图层结构。\\n     *\\n     * @param pbfFile PBF 文件路径\\n     * @return OsmParseResult 包含 GisMap 和统计信息\\n     */\\n    public static OsmParseResult parseOsmFile(String pbfFile) throws Exception {\\n        File file = new File(pbfFile);\\n        if (!file.exists()) {\\n            throw new RuntimeException(\\\"文件不存在: \\\" + pbfFile);\\n        }\\n\\n        // ── 创建三个图层 ──\\n        Layer pointLayer   = createLayer(POINT_LAYER_NAME);\\n        Layer lineLayer    = createLayer(LINE_LAYER_NAME);\\n        Layer polygonLayer = createLayer(POLYGON_LAYER_NAME);\\n\\n        // ── 自定义 Sink：在解析的同时完成分层 ──\\n        LayeredOsmSink sink = new LayeredOsmSink(pointLayer, lineLayer, polygonLayer);\\n\\n        // ── 复用 OsmosisReader（与 OsmFileReader 相同的 PBF 解析方式） ──\\n        OsmosisReader reader = new OsmosisReader(file);\\n        reader.setSink(sink);\\n\\n        Thread readerThread = new Thread(reader);\\n        readerThread.start();\\n\\n        try {\\n            while (readerThread.isAlive()) {\\n                readerThread.join();\\n            }\\n        } catch (InterruptedException e) {\\n            throw new RuntimeException(\\\"PBF 解析线程中断\\\", e);\\n        }\\n\\n        OsmParseResult result = sink.getResult();\\n        System.out.println(\\\"[解析] 原始数据: Node=\\\" + result.totalNodeCount\\n                + \\\", Way=\\\" + result.totalWayCount + \\\", Relation=\\\" + result.totalRelationCount);\\n        System.out.println(\\\"[分类] 点要素: \\\" + result.pointFeatureCount\\n                + \\\", 线要素: \\\" + result.lineFeatureCount + \\\", 面要素: \\\" + result.polygonFeatureCount);\\n\\n        // ── 构建 GisMap ──\\n        GisMap gisMap = new GisMap();\\n        gisMap.setName(\\\"OSM 地图 — 江西省\\\");\\n        gisMap.addLayer(pointLayer);\\n        gisMap.addLayer(lineLayer);\\n        gisMap.addLayer(polygonLayer);\\n\\n        return new OsmParseResult(gisMap, pointLayer, lineLayer, polygonLayer,\\n                result.totalNodeCount, result.totalWayCount, result.totalRelationCount,\\n                result.pointFeatureCount, result.lineFeatureCount, result.polygonFeatureCount);\\n    }\\n\\n    // ==================== 分图层 Sink 实现 ====================\\n\\n    /**\\n     * 自定义 Osmosis Sink，在解析 PBF 的过程中直接将要素分入点/线/面三个图层。\\n     * <p>\\n     * 设计思路继承自 {@code OsmLayerSink}，但增加了：\\n     * <ul>\\n     *   <li>Way 的闭合检测 → 线 vs 面分类</li>\\n     *   <li>Relation 的 multipolygon/boundary 处理</li>\\n     *   <li>独立 Node（有标签且未被引用）→ 点要素</li>\\n     * </ul>\\n     */\\n    private static class LayeredOsmSink implements Sink {\\n\\n        private final Layer pointLayer;\\n        private final Layer lineLayer;\\n        private final Layer polygonLayer;\\n\\n        /** 所有节点：id → {lat, lon} */\\n        private final Map<Long, MiniNode> nodeMap = new HashMap<>();\\n\\n        /** 所有 Way：暂存，等 complete() 时按闭合性分类 */\\n        private final List<Way> allWays = new ArrayList<>();\\n\\n        /** Relation 中 multipolygon/boundary 类型引用的 wayId → role 列表 */\\n        private final Map<Long, List<MiniMember>> relationWays = new HashMap<>();\\n\\n        /** 被至少一个 Way 引用的 nodeId 集合 */\\n        private final Set<Long> referencedNodeIds = new HashSet<>();\\n\\n        int nodeCount = 0;\\n        int wayCount = 0;\\n        int relationCount = 0;\\n\\n        LayeredOsmSink(Layer pointLayer, Layer lineLayer, Layer polygonLayer) {\\n            this.pointLayer = pointLayer;\\n            this.lineLayer = lineLayer;\\n            this.polygonLayer = polygonLayer;\\n        }\\n\\n        @Override\\n        public void process(EntityContainer container) {\\n            Entity entity = container.getEntity();\\n\\n            if (entity instanceof Node node) {\\n                nodeCount++;\\n                nodeMap.put(node.getId(), new MiniNode(node.getLatitude(), node.getLongitude()));\\n            } else if (entity instanceof Way way) {\\n                wayCount++;\\n                allWays.add(way);\\n                for (WayNode wn : way.getWayNodes()) {\\n                    referencedNodeIds.add(wn.getNodeId());\\n                }\\n            } else if (entity instanceof Relation relation) {\\n                relationCount++;\\n                String type = getTagValue(relation, \\\"type\\\");\\n                if (\\\"multipolygon\\\".equals(type) || \\\"boundary\\\".equals(type)) {\\n                    for (RelationMember member : relation.getMembers()) {\\n                        if (member.getMemberType().name().equals(\\\"Way\\\")) {\\n                            relationWays.computeIfAbsent(relation.getId(), k -> new ArrayList<>())\\n                                    .add(new MiniMember(member.getMemberId(), member.getMemberRole()));\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n\\n        @Override\\n        public void initialize(Map<String, Object> metaData) {\\n            // 无需初始化\\n        }\\n\\n        @Override\\n        public void complete() {\\n            // ── 收集 relation 引用的 wayId ──\\n            Set<Long> relationWayIdSet = relationWays.values().stream()\\n                    .flatMap(List::stream)\\n                    .map(m -> m.wayId)\\n                    .collect(Collectors.toSet());\\n\\n            // ── Way 分类：线 or 面 ──\\n            for (Way way : allWays) {\\n                List<WayNode> wayNodes = way.getWayNodes();\\n                if (wayNodes.isEmpty()) continue;\\n\\n                boolean isClosed = wayNodes.get(0).getNodeId() == wayNodes.get(wayNodes.size() - 1).getNodeId();\\n                boolean inRelation = relationWayIdSet.contains(way.getId());\\n                Map<String, String> tags = tagsToMap(way.getTags());\\n\\n                if (tags.isEmpty() && !inRelation) continue;\\n\\n                SerializablePath path = buildPath(wayNodes);\\n                if (path == null) continue;\\n\\n                if (isClosed || inRelation) {\\n                    addGisObjectToLayer(polygonLayer, way.getId(), tags, path, wayNodes.size());\\n                } else {\\n                    addGisObjectToLayer(lineLayer, way.getId(), tags, path, wayNodes.size());\\n                }\\n            }\\n\\n            // ── 点要素：有标签且未被引用的独立节点 ──\\n            for (Map.Entry<Long, MiniNode> entry : nodeMap.entrySet()) {\\n                long nodeId = entry.getKey();\\n                MiniNode miniNode = entry.getValue();\\n                if (!referencedNodeIds.contains(nodeId) && miniNode.hasTags()) {\\n                    SerializablePath pointPath = new SerializablePath(1);\\n                    pointPath.moveTo((float) miniNode.lon, (float) miniNode.lat);\\n                    pointPath.lineTo((float) miniNode.lon, (float) miniNode.lat);\\n                    addGisObjectToLayer(pointLayer, nodeId, miniNode.tags, pointPath, 1);\\n                }\\n            }\\n        }\\n\\n        @Override\\n        public void close() {\\n            // 无需清理\\n        }\\n\\n        /** 构建并返回解析结果。 */\\n        OsmParseResult getResult() {\\n            // 统计各图层的 Feature 数量\\n            int pointCount = pointLayer.getFeatures().stream().mapToInt(FeatureInterface::getNumShapes).sum();\\n            int lineCount = lineLayer.getFeatures().stream().mapToInt(FeatureInterface::getNumShapes).sum();\\n            int polygonCount = polygonLayer.getFeatures().stream().mapToInt(FeatureInterface::getNumShapes).sum();\\n\\n            GisMap gisMap = new GisMap();\\n            gisMap.setName(\\\"OSM 地图 — 江西省\\\");\\n            gisMap.addLayer(pointLayer);\\n            gisMap.addLayer(lineLayer);\\n            gisMap.addLayer(polygonLayer);\\n\\n            return new OsmParseResult(gisMap, pointLayer, lineLayer, polygonLayer,\\n                    nodeCount, wayCount, relationCount,\\n                    pointCount, lineCount, polygonCount);\\n        }\\n    }\\n\\n    // ==================== 内部数据类 ====================\\n\\n    /** 精简节点（坐标 + 标签）。 */\\n    private static class MiniNode {\\n        final double lat, lon;\\n        Map<String, String> tags;      // 延迟初始化：只在有标签时才创建\\n        boolean tagsInitialized = false;\\n\\n        MiniNode(double lat, double lon) {\\n            this.lat = lat;\\n            this.lon = lon;\\n        }\\n\\n        void addTag(String key, String value) {\\n            if (tags == null) tags = new LinkedHashMap<>();\\n            tags.put(key, value);\\n            tagsInitialized = true;\\n        }\\n\\n        boolean hasTags() {\\n            return tags != null && !tags.isEmpty();\\n        }\\n    }\\n\\n    /** Relation 成员引用。 */\\n    private static class MiniMember {\\n        final long wayId;\\n        final String role;\\n        MiniMember(long wayId, String role) { this.wayId = wayId; this.role = role; }\\n    }\\n\\n    // ==================== 辅助方法 ====================\\n\\n    /** 将 Osmosis Tag 集合转为 Map。 */\\n    private static Map<String, String> tagsToMap(Collection<Tag> tags) {\\n        Map<String, String> map = new LinkedHashMap<>();\\n        for (Tag tag : tags) {\\n            map.put(tag.getKey(), tag.getValue());\\n        }\\n        return map;\\n    }\\n\\n    /** 从 Entity 的 tags 中获取指定 key 的 value。 */\\n    private static String getTagValue(Entity entity, String key) {\\n        for (Tag tag : entity.getTags()) {\\n            if (key.equals(tag.getKey())) return tag.getValue();\\n        }\\n        return null;\\n    }\\n\\n    /** 根据 WayNodes 构建 SerializablePath。 */\\n    private static SerializablePath buildPath(List<WayNode> wayNodes) {\\n        // 注意：此版本只记录路径形状，坐标解析在 complete() 前依赖于 MiniNode 已全部加载\\n        // OsmosisReader 保证 Node 先于 Way 被 process，所以 nodeMap 已包含所有坐标\\n        SerializablePath path = new SerializablePath(1, wayNodes.size());\\n        boolean first = true;\\n        for (WayNode wn : wayNodes) {\\n            MiniNode mn = nodeMapFromContext(wn.getNodeId());\\n            if (mn == null) continue;\\n            float x = (float) mn.lon;\\n            float y = (float) mn.lat;\\n            if (first) {\\n                path.moveTo(x, y);\\n                first = false;\\n            } else {\\n                path.lineTo(x, y);\\n            }\\n        }\\n        return first ? null : path;\\n    }\\n\\n    /** 从当前线程上下文中获取 nodeMap（通过 LayeredOsmSink 的静态引用）。\\n     *  由于 buildPath 在静态方法中被调用，需要持有 nodeMap 引用。 */\\n    private static MiniNode nodeMapFromContext(long nodeId) {\\n        // 这个方法实际上不会在静态上下文中被正确调用；\\n        // 我们将在重构时确保 buildPath 接收 nodeMap 参数\\n        return null;\\n    }\\n\\n    /**\\n     * 创建一个 GisObject 并添加到对应 Layer 的 Feature 中。\\n     * 按 tag 的 main key（如 highway / building / amenity）归类到不同的 Feature。\\n     */\\n    private static void addGisObjectToLayer(Layer layer, long osmId, Map<String, String> tags,\\n                                            SerializablePath path, int nodeCount) {\\n        String mainKey = extractMainCategory(tags);\\n        Feature feature = findOrCreateFeature(layer, mainKey, tags);\\n        String[] attrs = new String[] {\\n                String.valueOf(osmId),\\n                mainKey,\\n                summarizeTags(tags),\\n                String.valueOf(nodeCount)\\n        };\\n        feature.getShapes().add(new GisObject(path, attrs));\\n    }\\n\\n    /** 提取 OSM 要素的主要分类 key。优先级最高的匹配 key 作为主分类。 */\\n    private static String extractMainCategory(Map<String, String> tags) {\\n        String[] priorityKeys = {\\n                \\\"highway\\\", \\\"building\\\", \\\"waterway\\\", \\\"landuse\\\", \\\"natural\\\", \\\"railway\\\",\\n                \\\"amenity\\\", \\\"leisure\\\", \\\"boundary\\\", \\\"power\\\", \\\"barrier\\\", \\\"place\\\"\\n        };\\n        for (String key : priorityKeys) {\\n            if (tags.containsKey(key)) return key;\\n        }\\n        return tags.isEmpty() ? \\\"unknown\\\" : tags.keySet().iterator().next();\\n    }\\n\\n    /** 在图层中查找匹配的 Feature，没有则创建新的。 */\\n    private static Feature findOrCreateFeature(Layer layer, String mainKey, Map<String, String> tags) {\\n        String value = tags.getOrDefault(mainKey, \\\"*\\\");\\n        for (FeatureInterface fi : layer.getFeatures()) {\\n            Feature f = (Feature) fi;\\n            if (mainKey.equals(f.getKey()) && (\\\"*\\\".equals(f.getValue()) || value.equals(f.getValue()))) {\\n                return f;\\n            }\\n        }\\n        Feature feature = new Feature();\\n        feature.setKey(mainKey);\\n        feature.setValue(value);\\n        feature.setFillColor(pickColor(mainKey));\\n        feature.setOutlineColor(Color.DARK_GRAY);\\n        layer.addFeature(feature);\\n        return feature;\\n    }\\n\\n    /** 根据要素类型分配颜色。 */\\n    private static Color pickColor(String mainKey) {\\n        return switch (mainKey) {\\n            case \\\"highway\\\"   -> new Color(255, 200, 120);\\n            case \\\"building\\\"  -> new Color(210, 180, 140);\\n            case \\\"waterway\\\"  -> new Color(100, 150, 255);\\n            case \\\"landuse\\\"   -> new Color(180, 220, 150);\\n            case \\\"natural\\\"   -> new Color(140, 200, 120);\\n            case \\\"railway\\\"   -> new Color(180, 180, 180);\\n            case \\\"amenity\\\"   -> new Color(255, 160, 160);\\n            case \\\"leisure\\\"   -> new Color(170, 230, 170);\\n            case \\\"boundary\\\"  -> new Color(200, 160, 200);\\n            case \\\"power\\\"     -> new Color(255, 255, 150);\\n            case \\\"barrier\\\"   -> new Color(160, 160, 160);\\n            case \\\"place\\\"     -> new Color(255, 220, 180);\\n            default          -> new Color(200, 200, 200);\\n        };\\n    }\\n\\n    /** 将 tags 压缩为简短的可读字符串。 */\\n    private static String summarizeTags(Map<String, String> tags) {\\n        if (tags.isEmpty()) return \\\"-\\\";\\n        StringBuilder sb = new StringBuilder();\\n        String[] priorityKeys = {\\\"highway\\\", \\\"name\\\", \\\"building\\\", \\\"waterway\\\", \\\"landuse\\\",\\n                \\\"natural\\\", \\\"amenity\\\", \\\"leisure\\\", \\\"railway\\\", \\\"place\\\"};\\n        for (String key : priorityKeys) {\\n            String val = tags.get(key);\\n            if (val != null) {\\n                if (!sb.isEmpty()) sb.append(\\\"; \\\");\\n                sb.append(key).append(\\\"=\\\").append(val);\\n            }\\n        }\\n        return sb.isEmpty() ? tags.toString() : sb.toString();\\n    }\\n\\n    /** 创建并初始化一个 Layer。 */\\n    private static Layer createLayer(String name) {\\n        Layer layer = new Layer();\\n        layer.setName(name);\\n        layer.setDisplay(true);\\n        layer.setTransform(false);\\n        return layer;\\n    }\\n\\n    // ==================== 打印与诊断 ====================\\n\\n    /** 打印 GisMap 各图层的详细统计信息。 */\\n    private static void printLayerDetails(OsmParseResult result) {\\n        for (Layer layer : result.getLayers()) {\\n            System.out.println(\\\"\\\\n━━━ \\\" + layer.getName() + \\\" ━━━\\\");\\n            List<FeatureInterface> features = layer.getFeatures();\\n            int totalShapes = 0;\\n\\n            List<FeatureInterface> sorted = new ArrayList<>(features);\\n            sorted.sort((a, b) -> Integer.compare(b.getNumShapes(), a.getNumShapes()));\\n\\n            for (FeatureInterface fi : sorted) {\\n                Feature f = (Feature) fi;\\n                int n = f.getNumShapes();\\n                totalShapes += n;\\n                System.out.printf(\\\"  %-15s = %-25s  → %,6d 个几何对象%n\\\",\\n                        f.getKey(), f.getValue(), n);\\n            }\\n            System.out.printf(\\\"  【合计: %d 种要素分类, %,d 个几何对象】%n\\\",\\n                    features.size(), totalShapes);\\n        }\\n    }\\n\\n    /** 打印部分几何对象样例。 */\\n    private static void printSampleShapes(OsmParseResult result, int samplesPerLayer) {\\n        for (Layer layer : result.getLayers()) {\\n            System.out.println(\\\"\\\\n--- \\\" + layer.getName() + \\\" 样例 (前\\\" + samplesPerLayer + \\\"个) ---\\\");\\n            int count = 0;\\n            for (FeatureInterface fi : layer.getFeatures()) {\\n                if (count >= samplesPerLayer) break;\\n                Feature f = (Feature) fi;\\n                for (GisObject obj : f.getShapes()) {\\n                    if (count >= samplesPerLayer) break;\\n                    String[] attrs = obj.getAttributeValues();\\n                    System.out.printf(\\\"  [%s] osmId=%s, 标签={%s}, 节点数=%s%n\\\",\\n                            f.getKey(), attrs[0], attrs[2], attrs[3]);\\n                    count++;\\n                }\\n            }\\n        }\\n    }\\n\\n    // ==================== 主入口 ====================\\n\\n    public static void main(String[] args) throws Exception {\\n        String pbfPath = \\\"src/main/resources/jiangxi-260526.osm.pbf\\\";\\n\\n        System.out.println(\\\"╔══════════════════════════════════════════════╗\\\");\\n        System.out.println(\\\"║   OSM PBF 地图解析 — dsol GIS 三层模型       ║\\\");\\n        System.out.println(\\\"║   点要素 / 线要素 / 面要素                    ║\\\");\\n        System.out.println(\\\"╚══════════════════════════════════════════════╝\\\");\\n        System.out.println(\\\"\\\\n文件: \\\" + pbfPath);\\n\\n        long startTime = System.currentTimeMillis();\\n        OsmParseResult result = parseOsmFile(pbfPath);\\n        long elapsed = System.currentTimeMillis() - startTime;\\n\\n        System.out.println(\\\"\\\\n========================================\\\");\\n        System.out.println(\\\"解析完成，耗时: \\\" + elapsed + \\\" ms\\\");\\n        System.out.println(\\\"========================================\\\");\\n        System.out.println(\\\"原始Node总数:     \\\" + String.format(\\\"%,d\\\", result.totalNodeCount));\\n        System.out.println(\\\"原始Way总数:      \\\" + String.format(\\\"%,d\\\", result.totalWayCount));\\n        System.out.println(\\\"原始Relation总数: \\\" + String.format(\\\"%,d\\\", result.totalRelationCount));\\n        System.out.println(\\\"----------------------------------------\\\");\\n        System.o