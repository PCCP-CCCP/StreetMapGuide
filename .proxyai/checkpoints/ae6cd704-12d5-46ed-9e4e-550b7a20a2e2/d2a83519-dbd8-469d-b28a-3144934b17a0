                    "text": "{\"file_path\":\"E:/StreetMapGuide/src/main/java/Main.java\",\"content\":\"import java.awt.Color;\\nimport java.io.File;\\nimport java.util.*;\\nimport java.util.stream.Collectors;\\n\\nimport org.openstreetmap.osmosis.core.container.v0_6.EntityContainer;\\nimport org.openstreetmap.osmosis.core.domain.v0_6.Entity;\\nimport org.openstreetmap.osmosis.core.domain.v0_6.Node;\\nimport org.openstreetmap.osmosis.core.domain.v0_6.Relation;\\nimport org.openstreetmap.osmosis.core.domain.v0_6.RelationMember;\\nimport org.openstreetmap.osmosis.core.domain.v0_6.Tag;\\nimport org.openstreetmap.osmosis.core.domain.v0_6.Way;\\nimport org.openstreetmap.osmosis.core.domain.v0_6.WayNode;\\nimport org.openstreetmap.osmosis.core.task.v0_6.Sink;\\n\\nimport crosby.binary.osmosis.OsmosisReader;\\n\\nimport nl.tudelft.simulation.dsol.animation.gis.FeatureInterface;\\nimport nl.tudelft.simulation.dsol.animation.gis.GisObject;\\nimport nl.tudelft.simulation.dsol.animation.gis.SerializablePath;\\nimport nl.tudelft.simulation.dsol.animation.gis.map.Feature;\\nimport nl.tudelft.simulation.dsol.animation.gis.map.GisMap;\\nimport nl.tudelft.simulation.dsol.animation.gis.map.Layer;\\n\\n/**\\n * 使用 nl.tudelft.simulation.dsol.animation.gis.osm 库风格解析 OSM PBF 文件，\\n * 将地图要素按几何类型分为三个图层：\\n * <ul>\\n *   <li><b>点要素图层</b> — 带有标签且不被任何 Way 引用的独立 Node</li>\\n *   <li><b>线要素图层</b> — 非闭合 Way（道路、河流、铁路等）</li>\\n *   <li><b>面要素图层</b> — 闭合 Way（建筑物、土地利用）和 Multipolygon/Boundary Relation 中的 Way</li>\\n * </ul>\\n * <p>\\n * 复用 {@code dsol-animation-gis-osm} 中 {@link OsmosisReader} 的 PBF 解析能力，\\n * 继承 {@code OsmLayerSink} 的设计思路，通过自定义的 {@link LayeredOsmSink}\\n * 在解析过程中直接分图层构建 {@link GisMap}。\\n */\\npublic class Main {\\n\\n    // ==================== 图层名称常量 ====================\\n    private static final String POINT_LAYER_NAME   = \\\"点要素图层 (Points)\\\";\\n    private static final String LINE_LAYER_NAME    = \\\"线要素图层 (Lines)\\\";\\n    private static final String POLYGON_LAYER_NAME = \\\"面要素图层 (Polygons)\\\";\\n\\n    // ==================== 解析结果类型 ====================\\n\\n    /** 解析结果：包含 GisMap（含三层图层）和统计摘要。 */\\n    public static class OsmParseResult {\\n        public final GisMap gisMap;\\n        public final Layer pointLayer;\\n        public final Layer lineLayer;\\n        public final Layer polygonLayer;\\n        public final int totalNodeCount;\\n        public final int totalWayCount;\\n        public final int totalRelationCount;\\n        public final int pointFeatureCount;\\n        public final int lineFeatureCount;\\n        public final int polygonFeatureCount;\\n\\n        public OsmParseResult(GisMap gisMap, Layer pointLayer, Layer lineLayer, Layer polygonLayer,\\n                              int totalNodeCount, int totalWayCount, int totalRelationCount,\\n                              int pointFeatureCount, int lineFeatureCount, int polygonFeatureCount) {\\n            this.gisMap = gisMap;\\n            this.pointLayer = pointLayer;\\n            this.lineLayer = lineLayer;\\n            this.polygonLayer = polygonLayer;\\n            this.totalNodeCount = totalNodeCount;\\n            this.totalWayCount = totalWayCount;\\n            this.totalRelationCount = totalRelationCount;\\n            this.pointFeatureCount = pointFeatureCount;\\n            this.lineFeatureCount = lineFeatureCount;\\n            this.polygonFeatureCount = polygonFeatureCount;\\n        }\\n\\n        /** 返回所有图层的列表（便于迭代）。 */\\n        public List<Layer> getLayers() {\\n            return List.of(pointLayer, lineLayer, polygonLayer);\\n        }\\n    }\\n\\n    // ==================== 核心解析方法 ====================\\n\\n    /**\\n     * 解析 OSM PBF 文件，将要素按几何类型分到点/线/面三个图层。\\n     * <p>\\n     * 使用与 {@code OsmFileReader} 相同的 {@link OsmosisReader} 进行 PBF 解析，\\n     * 但通过自定义的 {@link LayeredOsmSink} 直接构建三层图层结构。\\n     *\\n     * @param pbfFile PBF 文件路径\\n     * @return OsmParseResult 包含 GisMap 和统计信息\\n     */\\n    public static OsmParseResult parseOsmFile(String pbfFile) throws Exception {\\n        File file = new File(pbfFile);\\n        if (!file.exists()) {\\n            throw new RuntimeException(\\\"文件不存在: \\\" + pbfFile);\\n        }\\n\\n        // ── 创建三个图层 ──\\n        Layer pointLayer   = createLayer(POINT_LAYER_NAME);\\n        Layer lineLayer    = createLayer(LINE_LAYER_NAME);\\n        Layer polygonLayer = createLayer(POLYGON_LAYER_NAME);\\n\\n        // ── 自定义 Sink：在解析的同时完成分层 ──\\n        LayeredOsmSink sink = new LayeredOsmSink(pointLayer, lineLayer, polygonLayer);\\n\\n        // ── 复用 OsmosisReader（与 OsmFileReader 相同的 PBF 解析方式） ──\\n        OsmosisReader reader = new OsmosisReader(file);\\n        reader.setSink(sink);\\n\\n        Thread readerThread = new Thread(reader);\\n        readerThread.start();\\n\\n        try {\\n            while (readerThread.isAlive()) {\\n                readerThread.join();\\n            }\\n        } catch (InterruptedException e) {\\n            throw new RuntimeException(\\\"PBF 解析线程中断\\\", e);\\n        }\\n\\n        OsmParseResult result = sink.getResult();\\n        System.out.println(\\\"[解析] 原始数据: Node=\\\" + result.totalNodeCount\\n                + \\\", Way=\\\" + result.totalWayCount + \\\", Relation=\\\" + result.totalRelationCount);\\n        System.out.println(\\\"[分类] 点要素: \\\" + result.pointFeatureCount\\n                + \\\", 线要素: \\\" + result.lineFeatureCount + \\\", 面要素: \\\" + result.polygonFeatureCount);\\n\\n        // ── 构建 GisMap ──\\n        GisMap gisMap = new GisMap();\\n        gisMap.setName(\\\"OSM 地图 — 江西省\\\");\\n        gisMap.addLayer(pointLayer);\\n        gisMap.addLayer(lineLayer);\\n        gisMap.addLayer(polygonLayer);\\n\\n        return new OsmParseResult(gisMap, pointLayer, lineLayer, polygonLayer,\\n                result.totalNodeCount, result.totalWayCount, result.totalRelationCount,\\n                result.pointFeatureCount, result.lineFeatureCount, result.polygonFeatureCount);\\n    }\\n\\n    // ==================== 分图层 Sink 实现 ====================\\n\\n    /**\\n     * 自定义 Osmosis Sink，在解析 PBF 的过程中直接将要素分入点/线/面三个图层。\\n     * <p>\\n     * 设计思路继承自 {@code OsmLayerSink}，但增加了三层分类能力：\\n     * <ul>\\n     *   <li>Way 的闭合检测 → 线 vs 面分类</li>\\n     *   <li>Relation 的 multipolygon/boundary 处理</li>\\n     *   <li>独立 Node（有标签且未被引用）→ 点要素</li>\\n     * </ul>\\n     */\\n    private static class LayeredOsmSink implements Sink {\\n\\n        private final Layer pointLayer;\\n        private final Layer lineLayer;\\n        private final Layer polygonLayer;\\n\\n        /** 所有节点：id → {lat, lon, tags} */\\n        private final Map<Long, MiniNode> nodeMap = new HashMap<>();\\n\\n        /** 所有 Way：暂存，等 complete() 时按闭合性分类 */\\n        private final List<Way> allWays = new ArrayList<>();\\n\\n        /** Relation 中 multipolygon/boundary 类型引用的 wayId → role 列表 */\\n        private final Map<Long, List<MiniMember>> relationWays = new HashMap<>();\\n\\n        /** 被至少一个 Way 引用的 nodeId 集合 */\\n        private final Set<Long> referencedNodeIds = new HashSet<>();\\n\\n        int nodeCount = 0;\\n        int wayCount = 0;\\n        int relationCount = 0;\\n\\n        LayeredOsmSink(Layer pointLayer, Layer lineLayer, Layer polygonLayer) {\\n            this.pointLayer = pointLayer;\\n            this.lineLayer = lineLayer;\\n            this.polygonLayer = polygonLayer;\\n        }\\n\\n        @Override\\n        public void process(EntityContainer container) {\\n            Entity entity = container.getEntity();\\n\\n            if (entity instanceof Node node) {\\n                nodeCount++;\\n                MiniNode mini = new MiniNode(node.getLatitude(), node.getLongitude());\\n                for (Tag tag : node.getTags()) {\\n                    mini.addTag(tag.getKey(), tag.getValue());\\n                }\\n                nodeMap.put(node.getId(), mini);\\n\\n            } else if (entity instanceof Way way) {\\n                wayCount++;\\n                allWays.add(way);\\n                for (WayNode wn : way.getWayNodes()) {\\n                    referencedNodeIds.add(wn.getNodeId());\\n                }\\n\\n            } else if (entity instanceof Relation relation) {\\n                relationCount++;\\n                String type = getTagValue(relation, \\\"type\\\");\\n                if (\\\"multipolygon\\\".equals(type) || \\\"boundary\\\".equals(type)) {\\n                    for (RelationMember member : relation.getMembers()) {\\n                        if (member.getMemberType().name().equals(\\\"Way\\\")) {\\n                            relationWays.computeIfAbsent(relation.getId(), k -> new ArrayList<>())\\n                                    .add(new MiniMember(member.getMemberId(), member.getMemberRole()));\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n\\n        @Override\\n        public void initialize(Map<String, Object> metaData) {\\n            // 无需初始化\\n        }\\n\\n        @Override\\n        public void complete() {\\n            // ── 收集 relation 引用的 wayId ──\\n            Set<Long> relationWayIdSet = relationWays.values().stream()\\n                    .flatMap(List::stream)\\n                    .map(m -> m.wayId)\\n                    .collect(Collectors.toSet());\\n\\n            // ── Way 分类：线 or 面 ──\\n            for (Way way : allWays) {\\n                List<WayNode> wayNodes = way.getWayNodes();\\n                if (wayNodes.isEmpty()) continue;\\n\\n                boolean isClosed = wayNodes.get(0).getNodeId() == wayNodes.get(wayNodes.size() - 1).getNodeId();\\n                boolean inRelation = relationWayIdSet.contains(way.getId());\\n                Map<String, String> tags = tagsToMap(way.getTags());\\n\\n                if (tags.isEmpty() && !inRelation) continue;\\n\\n                SerializablePath path = buildPath(wayNodes);\\n                if (path == null) continue;\\n\\n                if (isClosed || inRelation) {\\n              