e wn : wayNodes) {\\n                MiniNode mn = nodeMap.get(wn.getNodeId());\\n                if (mn == null) continue;\\n                float x = (float) mn.lon;\\n                float y = (float) mn.lat;\\n                if (first) {\\n                    path.moveTo(x, y);\\n                    first = false;\\n                } else {\\n                    path.lineTo(x, y);\\n                }\\n            }\\n            return first ? null : path;\\n        }\\n\\n        private void addGisObjectToLayer(Layer layer, long osmId, Map<String, String> tags,\\n                                         SerializablePath path, int nodeCount) {\\n            String mainKey = extractMainCategory(tags);\\n            Feature feature = findOrCreateFeature(layer, mainKey, tags);\\n            String[] attrs = new String[] {\\n                    String.valueOf(osmId),\\n                    mainKey,\\n                    summarizeTags(tags),\\n                    String.valueOf(nodeCount)\\n            };\\n            feature.getShapes().add(new GisObject(path, attrs));\\n        }\\n    }\\n\\n    // ==================== 内部数据类 ====================\\n\\n    /** 精简节点（坐标 + 标签，延迟初始化标签 Map）。 */\\n    private static class MiniNode {\\n        final double lat, lon;\\n        Map<String, String> tags;\\n\\n        MiniNode(double lat, double lon) {\\n            this.lat = lat;\\n            this.lon = lon;\\n        }\\n\\n        void addTag(String key, String value) {\\n            if (tags == null) tags = new LinkedHashMap<>();\\n            tags.put(key, value);\\n        }\\n\\n        boolean hasTags() {\\n            return tags != null && !tags.isEmpty();\\n        }\\n    }\\n\\n    /** Relation 成员引用。 */\\n    private static class MiniMember {\\n        final long wayId;\\n        final String role;\\n        MiniMember(long wayId, String role) { this.wayId = wayId; this.role = role; }\\n    }\\n\\n    // ==================== 辅助方法 ====================\\n\\n    /** 将 Osmosis Tag 集合转为 Map。 */\\n    private static Map<String, String> tagsToMap(Collection<Tag> tags) {\\n        Map<String, String> map = new LinkedHashMap<>();\\n        for (Tag tag : tags) {\\n            map.put(tag.getKey(), tag.getValue());\\n        }\\n        return map;\\n    }\\n\\n    /** 从 Entity 的 tags 中获取指定 key 的 value。 */\\n    private static String getTagValue(Entity entity, String key) {\\n        for (Tag tag : entity.getTags()) {\\n            if (key.equals(tag.getKey())) return tag.getValue();\\n        }\\n        return null;\\n    }\\n\\n    /** 提取 OSM 要素的主要分类 key。优先级最高的匹配 key 作为主分类。 */\\n    private static String extractMainCategory(Map<String, String> tags) {\\n        String[] priorityKeys = {\\n                \\\"highway\\\", \\\"building\\\", \\\"waterway\\\", \\\"landuse\\\", \\\"natural\\\", \\\"railway\\\",\\n                \\\"amenity\\\", \\\"leisure\\\", \\\"boundary\\\", \\\"power\\\", \\\"barrier\\\", \\\"place\\\"\\n        };\\n        for (String key : priorityKeys) {\\n            if (tags.containsKey(key)) return key;\\n        }\\n        return tags.isEmpty() ? \\\"unknown\\\" : tags.keySet().iterator().next();\\n    }\\n\\n    /** 在图层中查找匹配的 Feature，没有则创建新的。 */\\n    private static Feature findOrCreateFeature(Layer layer, String mainKey, Map<String, String> tags) {\\n        String value = tags.getOrDefault(mainKey, \\\"*\\\");\\n        for (FeatureInterface fi : layer.getFeatures()) {\\n            Feature f = (Feature) fi;\\n            if (mainKey.equals(f.getKey()) && (\\\"*\\\".equals(f.getValue()) || value.equals(f.getValue()))) {\\n                return f;\\n            }\\n        }\\n        Feature feature = new Feature();\\n        feature.setKey(mainKey);\\n        feature.setValue(value);\\n        feature.setFillColor(pickColor(mainKey));\\n        feature.setOutlineColor(Color.DARK_GRAY);\\n        layer.addFeature(feature);\\n        return feature;\\n    }\\n\\n    /** 根据要素类型分配颜色。 */\\n    private static Color pickColor(String mainKey) {\\n        return switch (mainKey) {\\n            case \\\"highway\\\"   -> new Color(255, 200, 120);\\n            case \\\"building\\\"  -> new Color(210, 180, 140);\\n            case \\\"waterway\\\"  -> new Color(100, 150, 255);\\n            case \\\"landuse\\\"   -> new Color(180, 220, 150);\\n            case \\\"natural\\\"   -> new Color(140, 200, 120);\\n            case \\\"railway\\\"   -> new Color(180, 180, 180);\\n            case \\\"amenity\\\"   -> new Color(255, 160, 160);\\n            case \\\"leisure\\\"   -> new Color(170, 230, 170);\\n            case \\\"boundary\\\"  -> new Color(200, 160, 200);\\n            case \\\"power\\\"     -> new Color(255, 255, 150);\\n            case \\\"barrier\\\"   -> new Color(160, 160, 160);\\n            case \\\"place\\\"     -> new Color(255, 220, 180);\\n            default          -> new Color(200, 200, 200);\\n        };\\n    }\\n\\n    /** 将 tags 压缩为简短的可读字符串。 */\\n    private static String summarizeTags(Map<String, String> tags) {\\n        if (tags.isEmpty()) return \\\"-\\\";\\n        StringBuilder sb = new StringBuilder();\\n        String[] priorityKeys = {\\\"highway\\\", \\\"name\\\", \\\"building\\\", \\\"waterway\\\", \\\"landuse\\\",\\n                \\\"natural\\\", \\\"amenity\\\", \\\"leisure\\\", \\\"railway\\\", \\\"place\\\"};\\n        for (String key : priorityKeys) {\\n            String val = tags.get(key);\\n            if (val != null) {\\n                if (!sb.isEmpty()) sb.append(\\\"; \\\");\\n                sb.append(key).append(\\\"=\\\").append(val);\\n            }\\n        }\\n        return sb.isEmpty() ? tags.toString() : sb.toString();\\n    }\\n\\n    /** 创建并初始化一个 Layer。 */\\n    private static Layer createLayer(String name) {\\n        Layer layer = new Layer();\\n        layer.setName(name);\\n        layer.setDisplay(true);\\n        layer.setTransform(false);\\n        return layer;\\n    }\\n\\n    // ==========